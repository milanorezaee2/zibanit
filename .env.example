# ─────────────────────────────────────────────────────────────────────────────
# GEMORIA — environment configuration
#
# Copy this file to `.env` and adjust for your machine:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
# Next.js sets this automatically for `next dev` / `next build`; set it explicitly
# for standalone scripts if you need production semantics.
NODE_ENV=development

# Public base URL of the museum. Used for canonical URLs, sitemap and OpenGraph.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# The application speaks exactly one SQL dialect (PostgreSQL) everywhere.
# Only the *driver* changes between environments.
#
# development / preview  → PGlite (PostgreSQL compiled to WebAssembly, in-process)
# production             → a real PostgreSQL server, configured through DATABASE_URL
#
# In production, DATABASE_URL is REQUIRED and PGlite is refused outright.
# See src/lib/env.ts — the rules are enforced by a schema, not by convention.

# Real PostgreSQL connection string. Required when NODE_ENV=production.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgres://gemoria:change-me@127.0.0.1:5432/gemoria

# Optional: set to false for managed providers that require TLS verification
# against a CA bundle you have not mounted. Leave unset for local servers.
# DATABASE_SSL=true

# Explicit driver override. Leave unset in normal use: the driver is derived from
# NODE_ENV and DATABASE_URL. Accepted values: pglite | postgres
# DB_DRIVER=pglite

# Where PGlite keeps its data directory (development and preview only).
# Git-ignored. Deleted safely at any time — it is a scratch database.
PGLITE_DATA_DIR=.data/pglite

# Apply pending migrations on first database access.
# Defaults to true outside production and false in production, always.
# DB_AUTO_MIGRATE=true

# ── Museum identity (public, safe to expose) ─────────────────────────────────
SITE_NAME=گموریا
SITE_NAME_LATIN=GEMORIA
DEFAULT_LOCALE=fa
