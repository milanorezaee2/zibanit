{
  "name": "gemoria",
  "version": "0.1.0",
  "private": true,
  "description": "GEMORIA — Digital Gemstone Museum. A luxury international digital museum of gemstones, minerals and geological specimens. Not an e-commerce application.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && node --import tsx scripts/copy-standalone-assets.mts",
    "start": "node --env-file-if-exists=.env --import tsx scripts/preflight.mts --production && node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "node --import tsx scripts/with-postgres.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-migrate.mts",
    "db:doctor": "node --env-file-if-exists=.env --import tsx scripts/db-doctor.mts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:server": "node --import tsx scripts/dev-postgres.mts",
    "start:next": "node --env-file-if-exists=.env --import tsx scripts/preflight.mts --production && next start --hostname 0.0.0.0 --port 3000",
    "smoke": "node --import tsx scripts/smoke.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "fontkit": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
